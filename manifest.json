{
  "manifest_version": 3,
  "name": "PawnHub",
  "version": "1.0.0",
  "description": "Custom themes, molded piece shapes, funny sound effects, and animations for Chess.com.",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "permissions": [
    "storage",
    "unlimitedStorage"
  ],
  "action": {
    "default_popup": "popup/popup.html",
    "default_title": "PawnHub Settings",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "options_page": "options/options.html",
  "content_scripts": [
    {
      "matches": [
        "https://www.chess.com/*",
        "https://chess.com/*"
      ],
      "js": [
        "content/masking.js",
        "content/pieces/crystal.js",
        "content/pieces/neon.js",
        "content/pieces/gold_obsidian.js",
        "content/pieces/paper_cut.js",
        "content/pieces/monsters.js",
        "content/pieces/index.js",
        "content/themes.js",
        "content/audio.js",
        "content/effects.js",
        "content/content.js"
      ],
      "css": [
        "content/content.css"
      ],
      "run_at": "document_idle"
    }
  ]
}
